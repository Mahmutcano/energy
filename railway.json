{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "dockerfilePath": "backend/Dockerfile",
        "context": "."
    },
    "deploy": {
        "startCommand": "node backend/dist/server.js",
        "healthcheckPath": "/",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE"
    }
}