generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum ProtocolType {
  MODBUS
  IEC104
}

enum ModbusDataType {
  INT16
  UINT16
  INT32
  UINT32
  FLOAT32
  BOOLEAN
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  name             String?
  role             Role            @default(CUSTOMER)
  companyProfileId String?
  companyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CompanyProfile {
  id        String   @id @default(uuid())
  name      String
  address   String?  @db.Text
  isActive  Boolean  @default(true)
  plants    Plant[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plant {
  id            String         @id @default(uuid())
  companyId     String
  company       CompanyProfile @relation(fields: [companyId], references: [id])
  plantName     String
  latitude      Decimal?       @db.Decimal(10, 8)
  longitude     Decimal?       @db.Decimal(11, 8)
  commProtocols CommProtocol[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DeviceCategory {
  id           String   @id @default(uuid())
  categoryName String
  isActive     Boolean  @default(true)
  devices      Device[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Device {
  id            String         @id @default(uuid())
  categoryId    String
  category      DeviceCategory @relation(fields: [categoryId], references: [id])
  deviceName    String
  isActive      Boolean        @default(true)
  commProtocols CommProtocol[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CommProtocol {
  id           String        @id @default(uuid())
  deviceId     String
  device       Device        @relation(fields: [deviceId], references: [id])
  plantId      String
  plant        Plant         @relation(fields: [plantId], references: [id])
  protocolType ProtocolType
  ipAddress    String?       @db.Inet
  
  modbusConfig ModbusConfig?
  iec104Config IEC104Config?
  
  // Operational relationships
  telemetry    Telemetry[]
  thresholds   AlarmThreshold[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ModbusConfig {
  id             String         @id @default(uuid())
  commProtocolId String         @unique
  commProtocol   CommProtocol   @relation(fields: [commProtocolId], references: [id])
  slaveId        Int
  regAddress     Int
  dataType       ModbusDataType
}

model IEC104Config {
  id             String       @id @default(uuid())
  commProtocolId String       @unique
  commProtocol   CommProtocol @relation(fields: [commProtocolId], references: [id])
  asduAddress    Int
  t0_timeout     Int
  k_window       Int
}

model Telemetry {
  id             BigInt       @id @default(autoincrement())
  commProtocolId String
  commProtocol   CommProtocol @relation(fields: [commProtocolId], references: [id])
  value          Float
  timestamp      DateTime     @default(now())

  @@index([commProtocolId, timestamp])
}

model AlarmThreshold {
  id             String       @id @default(uuid())
  commProtocolId String
  commProtocol   CommProtocol @relation(fields: [commProtocolId], references: [id])
  lowThreshold   Float?
  highThreshold  Float?
  severity       Severity     @default(WARNING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AlarmLog {
  id             String   @id @default(uuid())
  commProtocolId String
  value          Float
  message        String
  severity       Severity
  timestamp      DateTime @default(now())
  resolved       Boolean  @default(false)
}
